# Spotify Web API (Authorization Code flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TRENDING_NOW_PLAYLIST_ID=
SPOTIFY_TOP_100_PLAYLIST_ID=
SPOTIFY_NIGHT_OUT_PLAYLIST_ID=

# SRGSSR Audio API (client credentials)
SRF_CLIENT_ID=
SRF_CLIENT_SECRET=

# Error tracking
SENTRY_DSN=

# Reauthorization flow
# Public HTTPS URL of the Cloudflare Tunnel, path must be /callback.
# Must be added as a Redirect URI in the Spotify developer dashboard.
SPOTIFY_REDIRECT_URI=
# Public base URL of the intermediate reauth page for the reminder mail links.
REAUTH_PAGE_BASE_URL=
# Local port the callback server binds to (127.0.0.1); the tunnel maps here.
REAUTH_PORT=
# How long a reauth link / callback window stays valid (tunnel + server stay up this long).
REAUTH_WINDOW_HOURS=
# Minimum hours between reauth mails
REAUTH_MAIL_INTERVAL_HOURS=
# Age (days since user authorization) at which the loop starts reminding.
REAUTH_REMINDER_DAYS=

# Resend
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

